# Copy to .env for local customization (never commit real secrets or third-party PII).
# All variables are optional; safe RFC 2606 placeholders are used by default.

VITE_STUDIO_EMAIL=hello@example.com
VITE_STUDIO_PHONE=+34 600 000 000
VITE_STUDIO_SOCIAL_HANDLE=@studio.concept
VITE_STUDIO_SOCIAL_URL=https://studio.example.com
VITE_STUDIO_WEBSITE_LABEL=studio.example.com

# Host port for docker compose
PORT=8080
